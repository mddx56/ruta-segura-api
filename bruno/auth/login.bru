meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{prd}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "juan@example.com",
    "password": "1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}
